<UserControl x:Class="OhmyPort.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OhmyPort.App.Controls"
             Background="Transparent">
  <Grid Margin="8,6,8,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 端口连接配置 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,4" Orientation="Horizontal">
      <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="端口" />
      <ComboBox x:Name="PortCombo" Width="190" ToolTip="可用串口列表" />
      <Button x:Name="RefreshButton" Margin="6,0,0,0" Content="刷新" ToolTip="重新扫描可用串口" />
      <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="波特率" />
      <ComboBox x:Name="BaudCombo" Width="110" IsEditable="True" IsTextSearchEnabled="False"
                ToolTip="可直接输入自定义波特率（记得回车确认）" />
    </StackPanel>

    <!-- 完整串口参数（默认隐藏，视图菜单里打开） -->
    <StackPanel x:Name="ParamsPanel" Grid.Row="1" Margin="0,0,0,4" Orientation="Horizontal"
                Visibility="Collapsed">
      <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="数据位" />
      <ComboBox x:Name="DataBitsCombo" Width="64" />
      <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="停止位" />
      <ComboBox x:Name="StopBitsCombo" Width="64" />
      <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="校验位" />
      <ComboBox x:Name="ParityCombo" Width="70" />
      <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="流控" />
      <ComboBox x:Name="FlowCombo" Width="100"
                ToolTip="Windows 驱动不支持 DTR/DSR 流控，选择后将按无流控打开" />
      <CheckBox x:Name="DtrCheck" Margin="12,0,0,0" VerticalAlignment="Center" Content="DTR"
                IsChecked="True" />
      <CheckBox x:Name="RtsCheck" Margin="10,0,0,0" VerticalAlignment="Center" Content="RTS"
                IsChecked="True" />
    </StackPanel>

    <!-- 关键词过滤（默认隐藏，视图菜单里打开；含编码与 HEX 显示） -->
    <StackPanel x:Name="FilterPanel" Grid.Row="2" Margin="0,0,0,4" Orientation="Horizontal"
                Visibility="Collapsed">
      <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="关键词" />
      <TextBox x:Name="KeywordEdit" Width="220" ToolTip="多个关键词用逗号/空格分隔，如 Err,Timeout,0x50"
               KeyDown="OnKeywordKeyDown" />
      <ComboBox x:Name="ModeCombo" Width="150" Margin="6,0,0,0" />
      <CheckBox x:Name="CaseCheck" Margin="10,0,0,0" VerticalAlignment="Center" Content="区分大小写" />
      <CheckBox x:Name="RegexCheck" Margin="8,0,0,0" VerticalAlignment="Center" Content="正则"
                ToolTip="把关键词当作正则表达式匹配" />
      <TextBlock Margin="14,0,6,0" VerticalAlignment="Center" Text="编码" />
      <ComboBox x:Name="EncodingCombo" Width="90" />
      <CheckBox x:Name="HexViewCheck" Margin="12,0,0,0" VerticalAlignment="Center" Content="HEX显示" />
      <Button x:Name="FilterButton" Margin="12,0,0,0" Content="应用" ToolTip="启用 / 关闭关键词过滤" />
    </StackPanel>

    <!-- 协议帧解析（默认隐藏，视图菜单里打开；详情可折叠） -->
    <StackPanel x:Name="ProtocolPanel" Grid.Row="3" Margin="0,0,0,4" Orientation="Horizontal"
                Visibility="Collapsed">
      <CheckBox x:Name="FrameEnableCheck" Margin="0,0,10,0" VerticalAlignment="Center"
                Content="按帧解析" ToolTip="开启后接收按协议帧切分（帧头/长度/校验）" />
      <ToggleButton x:Name="ProtocolFoldButton" Margin="0,0,8,0" Padding="6,0" FontSize="11"
                    Content="收起 ▴" ToolTip="折叠 / 展开协议参数" Click="OnToggleProtocolDetailClick" />
      <StackPanel x:Name="ProtocolDetailPanel" Orientation="Horizontal">
        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="帧头" />
        <TextBox x:Name="FrameHeaderEdit" Width="78" ToolTip="帧头 HEX，如 AA 55；留空则不匹配帧头" />
        <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Text="帧尾" />
        <TextBox x:Name="FrameTailEdit" Width="78" ToolTip="帧尾 HEX，如 0D 0A；留空则按长度切帧" />
        <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Text="长度字段" />
        <ComboBox x:Name="FrameLengthCombo" Width="60" ToolTip="长度字段字节数（0 表示无长度字段）" />
        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="长度基准" />
        <TextBox x:Name="FrameLengthBaseEdit" Width="46" ToolTip="长度字段值再加上的偏移（可为负）" />
        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="字节序" />
        <ComboBox x:Name="FrameEndianCombo" Width="66" ToolTip="长度字段的字节序" />
        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="校验" />
        <ComboBox x:Name="FrameChecksumCombo" Width="108" ToolTip="校验算法（覆盖帧头+长度+数据）" />
        <Button x:Name="EditFieldsButton" Margin="10,0,0,0" Content="字段..."
                ToolTip="编辑协议字段（名称 / 偏移 / 类型 / 系数）" />
      </StackPanel>
    </StackPanel>

    <!-- 日志区 -->
    <Border Grid.Row="4" Background="{DynamicResource Brush.LogSurface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3">
      <controls:LogView x:Name="LogText" MaxLines="50000">
        <controls:LogView.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="CopyMenuItem" Header="复制选中" InputGestureText="Ctrl+C" />
            <MenuItem x:Name="CopyAllMenuItem" Header="复制全部" />
            <MenuItem x:Name="SaveLogMenuItem" Header="保存日志" InputGestureText="Ctrl+S" />
            <Separator />
            <MenuItem x:Name="ClearMenuItem" Header="清空显示" />
          </ContextMenu>
        </controls:LogView.ContextMenu>
      </controls:LogView>
    </Border>

    <!-- 帧字段解析结果（默认隐藏，视图菜单「字段解析」打开） -->
    <Border x:Name="FieldsPanel" Grid.Row="5" Margin="0,4,0,0"
            Background="{DynamicResource Brush.LogSurface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3"
            Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,3,8,3" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Text="帧字段" />
          <TextBlock x:Name="FieldsHint" Margin="8,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Muted}" Text="（等待数据）" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="8,2,8,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="名称" Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Grid.Column="1" Text="类型" Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Grid.Column="2" Text="值" Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Grid.Column="3" Text="原始 HEX" Foreground="{DynamicResource Brush.Muted}" />
        </Grid>

        <ScrollViewer Grid.Row="2" MaxHeight="150" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="FieldsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,1,8,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding TypeLabel}"
                             Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock x:Name="ValueText" Grid.Column="2" Text="{Binding Text}" />
                  <TextBlock Grid.Column="3" Text="{Binding RawHex}"
                             Foreground="{DynamicResource Brush.Muted}" />
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Ok}" Value="False">
                    <Setter TargetName="ValueText" Property="Foreground"
                            Value="{DynamicResource Brush.Danger}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 命中结果分栏（split 模式显示） -->
    <Border x:Name="MatchedPanel" Grid.Row="6" Margin="0,4,0,0" Background="{DynamicResource Brush.LogSurface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3"
            Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="8,3,8,3" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Text="命中结果" />
          <Button x:Name="ClearMatchedButton" Margin="8,0,0,0" Content="清空" />
        </StackPanel>
        <controls:LogView x:Name="MatchedText" Grid.Row="1" MaxLines="50000" MinHeight="140" />
      </Grid>
    </Border>

    <!-- 日志操作行 -->
    <StackPanel Grid.Row="7" Margin="0,4,0,4" Orientation="Horizontal">
      <Button x:Name="ConnectButton" Content="打开串口" Tag="primary" ToolTip="打开 / 关闭当前串口" />
      <Button x:Name="PauseButton" Margin="6,0,0,0" Content="暂停"
              ToolTip="暂停刷新显示（后台仍持续接收、缓冲）" />
      <Button x:Name="ClearButton" Margin="6,0,0,0" Content="清空" ToolTip="清空显示与缓冲区" />
      <CheckBox x:Name="FixedCheck" Margin="12,0,0,0" VerticalAlignment="Center" Content="固定显示"
                ToolTip="日志持续追加但保持当前滚动位置（不自动跟随到底部）" />
      <Button x:Name="RecordButton" Margin="12,0,0,0" Content="开始记录"
              ToolTip="手动开始 / 停止日志记录" />
    </StackPanel>

    <!-- 消息发送 -->
    <Grid x:Name="SendPanel" Grid.Row="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="SendCombo" Grid.Column="0" IsEditable="True" IsTextSearchEnabled="False"
                ToolTip="发送内容（HEX 模式下输入如 01 03 00 0A）" />
      <ComboBox x:Name="NewlineCombo" Grid.Column="1" Width="80" Margin="6,0,0,0"
                ToolTip="发送后追加的换行符" />
      <CheckBox x:Name="HexSendCheck" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                Content="HEX发送" />
      <ComboBox x:Name="ChecksumCombo" Grid.Column="3" Width="118" Margin="12,0,0,0"
                ToolTip="发送时自动追加校验字节（追加在换行之前）" />
      <Button x:Name="SendButton" Grid.Column="4" Margin="12,0,0,0" Content="发送" Tag="primary"
              ToolTip="发送当前输入内容" />
    </Grid>
  </Grid>
</UserControl>
