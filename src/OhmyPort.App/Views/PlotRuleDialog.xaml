<Window x:Class="OhmyPort.App.Views.PlotRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="曲线提取规则" Width="640" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Style="{StaticResource Theme.Window}"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Muted}"
               Text="每行一条曲线。规则写法：正则含捕获组时取捕获组的值（如 temp=(\d+\.?\d*)）；否则按关键词取其后第一个数字（如 temp=）。取不到值的行会在曲线上断开。" />

    <Grid Grid.Row="1" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="曲线名称" Foreground="{DynamicResource Brush.Muted}" />
      <TextBlock Grid.Column="1" Text="提取规则（正则或关键词）" Foreground="{DynamicResource Brush.Muted}" />
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="RuleList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="1" Margin="6,0,0,0" FontFamily="Consolas"
                       Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="删除" Click="OnDeleteRowClick"
                      Tag="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="添加曲线" Click="OnAddRowClick" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="确定" Tag="primary" Width="80" Margin="0,0,8,0" Click="OnOkClick" />
        <Button Content="取消" Width="80" Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
