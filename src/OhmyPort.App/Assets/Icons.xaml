  <Geometry x:Key="Icon.info">M 12,3 A 9,9 0 0 0 12,21 A 9,9 0 0 0 12,3 Z M 12,11 V 17 M 12,8 H 12.1</Geometry>
  <Geometry x:Key="Icon.update">M 20,12 A 8,8 0 1 1 17,5.8 M 20,3 V 8 H 15</Geometry>

  <!-- ============ 会话操作 ============ -->
  <Geometry x:Key="Icon.pause">M 9,6 V 18 M 15,6 V 18</Geometry>
  <Geometry x:Key="Icon.clear">M 4,7 H 20 M 9,7 V 5 H 15 V 7 M 7,7 L 8,20 H 16 L 17,7</Geometry>
  <Geometry x:Key="Icon.record">M 12,8 A 4,4 0 0 0 12,16 A 4,4 0 0 0 12,8 Z</Geometry>

  <!-- ============ 图标样式 ============ -->
  <!-- Stretch 会把几何放大到 16×16，描边随之缩放，视觉粗细约 1.4px -->
  <Style x:Key="Theme.Icon" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Foreground}" />
    <Setter Property="StrokeThickness" Value="1.9" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

</ResourceDictionary>
