<Window x:Class="OhmyPort.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OhmyPort v1.8.7"
        Width="980" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/my-icon.ico">
  <Grid>
    <Image x:Name="BgLayer" Stretch="UniformToFill" IsHitTestVisible="False"
           Visibility="Collapsed">
      <Image.Effect>
        <BlurEffect x:Name="BgBlurEffect" Radius="0" />
      </Image.Effect>
    </Image>

    <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="保存日志" InputGestureText="Ctrl+S" Click="OnSaveLogClick" />
        <MenuItem Header="打开日志目录" Click="OnOpenLogDirClick" />
        <Separator />
        <MenuItem Header="导出配置..." Click="OnExportConfigClick" />
        <MenuItem Header="导入配置..." Click="OnImportConfigClick" />
        <Separator />
        <MenuItem Header="新建串口会话" InputGestureText="Ctrl+T" Click="OnNewSessionClick" />
        <MenuItem Header="关闭当前会话" Click="OnCloseCurrentSessionClick" />
        <Separator />
        <MenuItem Header="退出" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="视图(_V)">
        <MenuItem x:Name="ParamsMenu" Header="串口参数" IsCheckable="True" Click="OnToggleParamsClick" />
        <MenuItem x:Name="FilterMenu" Header="关键词过滤" IsCheckable="True" Click="OnToggleFilterClick" />
        <MenuItem x:Name="SendMenu" Header="消息发送" IsCheckable="True" IsChecked="True"
                  Click="OnToggleSendClick" />
        <MenuItem x:Name="SendAssistMenu" Header="发送辅助" IsCheckable="True" Click="OnToggleSendAssistClick" />
        <Separator />
        <MenuItem x:Name="HexViewMenu" Header="HEX 显示" IsCheckable="True" Click="OnToggleHexViewClick" />
        <MenuItem x:Name="FixedMenu" Header="固定显示" IsCheckable="True" Click="OnToggleFixedClick" />
        <MenuItem x:Name="WrapMenu" Header="自动换行" IsCheckable="True" IsChecked="True"
                  Click="OnToggleWrapClick" />
      </MenuItem>
      <MenuItem Header="设置(_S)">
        <MenuItem Header="主题">
          <MenuItem x:Name="ThemeAutoMenu" Header="跟随系统" IsCheckable="True" Click="OnThemeClick" Tag="auto" />
          <MenuItem x:Name="ThemeBlackMenu" Header="深色" IsCheckable="True" Click="OnThemeClick" Tag="black" />
          <MenuItem x:Name="ThemeDayMenu" Header="白天" IsCheckable="True" Click="OnThemeClick" Tag="day" />
          <MenuItem x:Name="ThemeEyeMenu" Header="护眼" IsCheckable="True" Click="OnThemeClick" Tag="eye" />
        </MenuItem>
        <MenuItem Header="背景皮肤..." Click="OnOpenBackgroundClick" />
        <Separator />
        <MenuItem Header="字体..." Click="OnChooseFontClick" />
        <MenuItem Header="字体增大" InputGestureText="Ctrl+=" Click="OnZoomInClick" />
        <MenuItem Header="字体减小" InputGestureText="Ctrl+-" Click="OnZoomOutClick" />
        <MenuItem Header="重置字体" InputGestureText="Ctrl+0" Click="OnResetZoomClick" />
        <Separator />
        <MenuItem x:Name="AutoRecordMenu" Header="连接后自动保存日志" IsCheckable="True"
                  Click="OnToggleAutoRecordClick" />
        <MenuItem Header="日志保存目录..." Click="OnChooseLogDirClick" />
        <MenuItem Header="日志分片大小..." Click="OnSetShardSizeClick" />
        <MenuItem Header="日志保留策略..." Click="OnSetLogRetentionClick" />
        <Separator />
        <MenuItem x:Name="TrayMenu" Header="关闭时最小化到托盘" IsCheckable="True"
                  Click="OnToggleTrayClick" />
        <MenuItem x:Name="CloseConfirmMenu" Header="关闭时询问" IsCheckable="True"
                  Click="OnToggleCloseConfirmClick" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于 OhmyPort" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource Brush.Panel}">
      <Grid Margin="10,0">
        <TextBlock x:Name="StatusLabel" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Muted}" Text="就绪" />
        <TextBlock x:Name="SessionCountLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Muted}" />
      </Grid>
    </Border>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TabControl x:Name="SessionTabs" Padding="0">
          <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
              <Setter Property="HeaderTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="ConnDot" Width="8" Height="8" Margin="0,0,6,0"
                               VerticalAlignment="Center" Fill="{DynamicResource Brush.Connected}"
                               Visibility="Collapsed" />
                      <TextBlock x:Name="TitleText" VerticalAlignment="Center" Text="{Binding Title}"
                                 Foreground="{DynamicResource Brush.Muted}" />
                      <Button Width="16" Height="16" Margin="8,0,0,0" Padding="0"
                              Background="Transparent" BorderThickness="0" FontSize="10"
                              Content="×" Tag="{Binding}" Click="OnCloseTabClick"
                              ToolTip="关闭会话（至少保留一个）" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter TargetName="ConnDot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="TitleText" Property="Foreground"
                                Value="{DynamicResource Brush.Connected}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TabControl.ItemContainerStyle>
        </TabControl>

        <Button x:Name="AddSessionButton" Width="26" Height="26" Margin="0,4,6,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FontSize="15"
                Content="＋" ToolTip="添加串口会话" Click="OnNewSessionClick" />
      </Grid>

      <!-- 发送辅助（全局面板，视图菜单「发送辅助」控制显示） -->
      <Border x:Name="SendAssistPanel" Grid.Row="1" Margin="0,4,0,0"
              Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
        <Grid Margin="8,6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,6" Orientation="Horizontal">
            <Button x:Name="AddCommandButton" Content="添加命令" Click="OnAddCommandClick" />
            <Button x:Name="AddPageButton" Margin="6,0,0,0" Content="添加页" Click="OnAddPageClick" />
            <Button x:Name="CycleButton" Margin="6,0,0,0" Content="定时循环发送..." Click="OnOpenCycleDialogClick" />
            <CheckBox x:Name="CycleIndicatorCheck" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="循环发送中" IsEnabled="False" IsChecked="{Binding CycleEnabled, Mode=OneWay}" />
          </StackPanel>

          <TabControl x:Name="CommandTabs" Grid.Row="1" Padding="0" />
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
  </Grid>
</Window>
